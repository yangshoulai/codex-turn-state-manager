# per-machine.
dev/cpa-docker/plugins/*.so
dev/cpa-docker/auths/
dev/cpa-docker/logs/
dev/cpa-docker/plugin-data/

# Editors / OS
.DS_Store
.idea/
.vscode/
*.swp
